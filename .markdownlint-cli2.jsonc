{
  // Reguli markdownlint pentru tot repo-ul. Lungimea liniilor e liberă (tabele, URL-uri).
  "config": {
    "default": true,
    "MD013": false,
    "MD033": false,
    "MD041": false,
    "MD024": { "siblings_only": true }
