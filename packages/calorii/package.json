{
  "name": "calorii",
  "version": "0.1.0",
  "description": "Calorie calculation engine: BMR (Mifflin-St Jeor, Harris-Benedict, Katch-McArdle), TDEE, calorie targets with safety floors, macronutrients, BMI, portions. Pure functions, zero dependencies. Motor de calcul calorii, fără dependențe.",
  "keywords": [
    "calorii",
    "calorie",
    "calculator",
    "bmr",
    "tdee",
    "macros",
    "bmi",
    "nutrition",
    "nutritie",
    "romania"
  ],
  "license": "MIT",
  "author": "Lento.fit (Netwise Media SRL) <hello@lento.fit>",
  "homepage": "https://github.com/Lento-fit/calorii/tree/main/packages/calorii#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lento-fit/calorii.git",
    "directory": "packages/calorii"
  },
  "bugs": "https://github.com/Lento-fit/calorii/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
