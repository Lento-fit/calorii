{
  "name": "calorii-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Calculator de calorii open-source: motor, date, site, server MCP, widget.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
