  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lento-fit/calorii.git"
  },
  "homepage": "https://lento.fit/",
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
